# Server-side only. Never expose these as NEXT_PUBLIC_*.
XENDIT_SECRET_KEY=xnd_development_REPLACE_ME

# Copy the Xendit webhook verification token from Dashboard -> Webhooks.
XENDIT_WEBHOOK_TOKEN=REPLACE_ME

# Live keys are blocked unless this is explicitly enabled.
# Keep false while building/testing and until Xendit has approved the exact use case.
XENDIT_ALLOW_LIVE=false

# Separate product/compliance gate for tourist foreign-card funding -> third-party PromptPay.
# Do not enable based only on normal Cards activation. Written Xendit approval is required.
XENDIT_CARD_BRIDGE_APPROVED=false
